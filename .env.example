# seeda does not automatically load .env files. Export these in your shell,
# or use Node.js --env-file with src/cli.ts.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# Optional: direct mode without a supervisor
# SEEDA_MANAGED=0
# Optional: explicit library/runtime paths (otherwise use defaults)
# SEEDA_LIBRARY=/path/to/strains-library
# SEEDA_HOME=/path/to/project-runtime
